
# Backend API URL
VITE_BASE_URL=http://localhost:5000/api

# Socket URL
VITE_SOCKET_URL=http://localhost:5000

# Google OAuth Client ID
VITE_CLIENT_ID=123456789012-example.apps.googleusercontent.com

# Stripe Publishable Key (Not Secret Key)
VITE_STRIPE_SECRET=pk_test_replace_with_your_publishable_key

# OLA Maps Restricted Public API Key (Not Private Secret)
VITE_OLA_API_SECRET=your_restricted_public_ola_maps_key
